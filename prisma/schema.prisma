// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 用户表
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  name          String?
  image         String?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // 订阅相关 (Legacy - 保留兼容)
  subscriptionTier SubscriptionTier @default(FREE)
  usageCount       Int             @default(0)
  resetDate        DateTime        @default(now())

  // 积分相关
  credits         Int             @default(0)    // 当前积分余额
  isLifetime      Boolean         @default(false) // 是否终身会员

  // 免费额度（与 SubscriptionTier 保留兼容）
  freeUsageCount  Int             @default(0)    // 当月已使用免费次数
  freeResetDate   DateTime        @default(now()) // 免费额度重置日期

  // 关联关系
  accounts    Account[]
  sessions     Session[]
  resumes      Resume[]
  subscriptions Subscription[]
  teamMembers   TeamMember[]
  payments      Payment[]

  @@map("users")
}

// NextAuth Account (第三方登录)
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// NextAuth Session
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// NextAuth VerificationToken
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// 简历历史表
model Resume {
  id              String   @id @default(cuid())
  userId          String
  originalText    String   @db.Text
  optimizedText   String?  @db.Text
  jobDescription  String?  @db.Text
  atsScore        Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("resumes")
}

// 订阅表
model Subscription {
  id                    String   @id @default(cuid())
  userId                String
  stripeCustomerId      String?  @unique
  stripeSubscriptionId  String?  @unique
  stripePriceId         String?
  stripeCurrentPeriodEnd DateTime?
  tier                  SubscriptionTier
  status                SubscriptionStatus @default(ACTIVE)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("subscriptions")
}

// 团队表
model Team {
  id          String   @id @default(cuid())
  name        String
  ownerId     String
  plan        TeamPlan @default(FREE)
  brandLogo   String?
  brandColor  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members TeamMember[]

  @@map("teams")
}

// 团队成员表
model TeamMember {
  id        String       @id @default(cuid())
  teamId    String
  userId    String
  role      TeamRole     @default(MEMBER)
  joinedAt  DateTime     @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

// API Key 表
model ApiKey {
  id          String   @id @default(cuid())
  userId      String
  name        String
  key         String   @unique @db.VarChar(64)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("api_keys")
}

// 支付记录表
model Payment {
  id              String   @id @default(cuid())
  userId          String
  type            PaymentType
  amount          Int          // 充值金额（分）
  credits         Int?         // 充值积分（仅 CREDIT）
  stripePaymentId String?
  vnativeOrderId  String?
  status          PaymentStatus @default(PENDING)
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("payments")
}

// 枚举定义
enum SubscriptionTier {
  FREE
  PRO
  PREMIUM
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

enum TeamPlan {
  FREE
  TEAM
  ENTERPRISE
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

enum PaymentType {
  CREDIT
  LIFETIME
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}
